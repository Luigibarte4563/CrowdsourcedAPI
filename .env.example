DB_HOST=localhost
DB_NAME=powerguide
DB_USER=root
DB_PASS=

GEOAPIFY_GEOCODING_API_KEY=

#JWT
# Any long random string. Tokens are HS256-signed with it, so changing it
# invalidates every existing session.
JWT_SECRET_KEY=

#Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/CrowdsourcedAPI/api/auth/google_callback.php

# Where the Google OAuth round trip sends the browser once the code is exchanged.
# This is NOT a CORS setting - it only decides the redirect target.
# It must match the frontend's dev server origin EXACTLY, including the port.
# The frontend pins Vite to 5174 with strictPort, so this is normally 5174.
# A mismatch is silent: the round trip still completes and still issues a valid
# JWT, but the browser is sent to an origin nothing is listening on, so
# /auth/google-callback never loads and the user is never forwarded to the app.
FRONTEND_URL=http://localhost:5174

# Browser origins allowed to call this API cross-origin, comma separated, no
# spaces. Only needed when the frontend is NOT going through the Vite dev proxy
# (same-origin), i.e. when VITE_API_BASE_URL is an absolute URL to Apache.
# Leave unset to use the built-in default:
#   http://localhost:5174, http://127.0.0.1:5174, http://localhost:5173, http://127.0.0.1:5173
# If you do set it, these four are replaced, not extended - re-list any you want.
# Reaching the dev server over the LAN (http://192.168.1.20:5174) means adding
# that origin here too, otherwise the browser gets no Access-Control-Allow-Origin.
# `*` is not an option: the session is an HttpOnly cookie sent with
# credentials: 'include', which the spec requires to be matched by an exact origin.
# ALLOWED_ORIGINS=

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

GEOAPIFY_GEOCODING_API_KEY=

#JWT
JWT_SECRET_KEY=

#Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/crowdsourcedapi/api/auth/google_callback.php

# Must match the PowerGuide frontend dev server origin EXACTLY, including the port.
# The frontend pins Vite to 5174 (strictPort), so 5173 is what this usually needs to be.
# A mismatch is silent: the OAuth round trip still completes and still issues a valid
# JWT, but the browser is sent to a port nothing is listening on, so
# /auth/google-callback never loads and the user is never forwarded to the dashboard.
FRONTEND_URL=http://localhost:5174
